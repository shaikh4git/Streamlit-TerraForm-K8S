
pipeline {
    agent { label 'DevopsAgentLabelV9' }

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        IMAGE_REPO = 'shaikhdocker/sshuda-streamlit-app'
    }

    stages {


        stage('Clean Workspaces!!') {
            steps { cleanWs() }
                }
 
        stage('Checkout GitHub') {
            steps {
                checkout(
                    changelog: true,
                    poll: true,
                    scm: scmGit(
                        branches: [[name: '*/main']],
                        userRemoteConfigs: [[
                            url: 'https://github.com/shaikh4git/Streamlit-TerraForm-K8S.git'
                        ]]
                    )
                )

                script {
                    env.IMAGE_TAG =
                        "${env.BUILD_NUMBER}-${env.GIT_COMMIT.take(7)}"
                    env.FULL_IMAGE =
                        "${env.IMAGE_REPO}:${env.IMAGE_TAG}"

                    echo "Changelog sets: ${currentBuild.changeSets.size()}"
                }
            }
        }

        
        stage ('Run only for relevant changes!!!') {
            when {
                anyOf {
                    changeset "AppCode/app.py"
                    changeset "AppCode/Dockerfile"
                    changeset "AppCode/requirements.txt"
                    changeset "AppCode/JenkinsTFCanary"
                    changeset "AppCode/tests/test_app.py"
                    changeset "AppCode/ansible/staging_canary.yaml"
                    changeset "terraform/main.tf"
                    changeset "terraform/outputs.tf"
                    changeset "terraform/variables.tf"
                    changeset "terraform/terrafom.tfvars"
                }
            }

            stages {
             
                stage('Gitleaks Secret Scanning') {
                    steps {
                        script {
                            sh '''
                                echo "Checking Git repository history..."

                                if [ "$(git rev-parse --is-shallow-repository)" = "true" ]; then
                                    git fetch --unshallow
                                else
                                    echo "Repository already has full history."
                                fi

                                echo "Starting Gitleaks security scan..."

                                gitleaks git . \
                                    --redact \
                                    --report-format json \
                                    --report-path gitleaks-report.json
                            '''
                        }
                    }

                    post {
                        always {
                        archiveArtifacts artifacts: 'gitleaks-report.json', allowEmptyArchive: true
                        }
                    }
                }

                stage('Install Python Dependencies for Streamlit Application Testing!!') {
                    steps {
                        sh '''
                            python3 -m venv .venv
                            .venv/bin/python -m pip install --upgrade pip
                            .venv/bin/python -m pip install -r requirements.txt
                            .venv/bin/python -m pip install pytest
                        '''
                    }
                }



                stage("Sonarqube Analysis "){
                    steps{
                        withSonarQubeEnv('sonar-server') {
                            sh ''' /opt/sonar-scanner/bin/sonar-scanner -Dsonar.projectName=Streamlit \
                            -Dsonar.projectKey=Streamlit '''
                        }
                    }
                }
                stage("quality gate"){
                    steps {
                        script {
                            waitForQualityGate abortPipeline: false, credentialsId: 'Sonar-token' 
                        }
                    } 
                }
                
                stage('Streamlit Application Testing') {
                    steps {
                        sh '''
                            echo "Checking Python syntax..."
                            .venv/bin/python -m py_compile app.py

                            echo "Running Streamlit unit tests..."
                            .venv/bin/python -m pytest tests/ -v

                            echo "Streamlit application testing completed!"
                        '''
                    }
                }                

                stage('OWASP FS SCAN') {
                    steps {
                        sh 'echo "Thirdparty Dependencies Check, skipping for now!! " ' 
                      //   dependencyCheck additionalArguments: '--scan ./ --disableYarnAudit --disableNodeAudit', odcInstallation: 'DP-Check'
                        // dependencyCheckPublisher pattern: '**/dependency-check-report.xml'
                    }
                }
                
                
                stage('TRIVY FS SCAN') {
                    steps {
                        sh "trivy fs . "
                        sh "trivy fs . > trivyfs.txt"
                    }
                } 

                stage('Docker Build Streamlit Image') {
                    steps {
                        sh '''
                            echo "Building Docker image: $FULL_IMAGE"

                            docker buildx build \
                                --tag "$FULL_IMAGE" \
                                --load \
                                .

                            echo "Docker image built successfully"
                        '''
                    }
                }

                 stage("TRIVY"){
                    steps{
                        sh "trivy image $FULL_IMAGE > trivyimage.txt" 
                    }
                } 

                stage('Docker Push to Docker Hub') {
                    steps {
                        withCredentials([
                            string(
                                credentialsId: 'docker_cred',
                                variable: 'DOCKER_API_KEY'
                            )
                        ]) {
                            sh '''
                                set -e
                                set +x

                                echo "$DOCKER_API_KEY" |
                                    docker login -u shaikhdocker --password-stdin

                                echo "Pushing image: $FULL_IMAGE"

                                docker push "$FULL_IMAGE"

                                echo "Docker image pushed successfully"
                            '''
                        }
                    }
                }


                stage('Deploy to Docker Desktop Staging - via Ansible') {
                    steps {
                        sh '''
                            ansible-playbook \
                            -i localhost, \
                            ansible/staging_canary.yaml \
                            -e "image_repo=$IMAGE_REPO" \
                            -e "image_tag=$IMAGE_TAG"
                        '''
                    }
                } 

                stage('Terraform Deploy Streamlit to Kubernetes') {
                    steps {
                        timeout(time: 15, unit: 'MINUTES') {
                            withCredentials([
                                file(
                                    credentialsId: 'kubeconfig-dockerdesktop',
                                    variable: 'KUBE_CONFIG_FILE'
                                )
                            ]) {
                                dir('terraform/kubernetes') {
                                    sh '''
                                        set -eu

                                        # Kubernetes authentication
                                        export KUBECONFIG="$KUBE_CONFIG_FILE"
                                        export KUBE_CONFIG_PATH="$KUBE_CONFIG_FILE"

                                        echo "========== Terraform Version =========="
                                        terraform version

                                        echo "========== Verify Kubernetes Access =========="
                                        kubectl auth can-i create deployments \
                                        -n streamlit-terraform | grep -qx yes

                                        kubectl auth can-i patch deployments \
                                        -n streamlit-terraform | grep -qx yes

                                        kubectl auth can-i create services \
                                        -n streamlit-terraform | grep -qx yes

                                        echo "========== Terraform Init =========="
                                        terraform init -input=false

                                        echo "========== Terraform Format =========="
                                        terraform fmt -check -recursive

                                        echo "========== Terraform Validate =========="
                                        terraform validate

                                        echo "========== Terraform Plan =========="
                                        set +e

                                        terraform plan \
                                        -input=false \
                                        -lock-timeout=5m \
                                        -detailed-exitcode \
                                        -var="image_repo=$IMAGE_REPO" \
                                        -var="image_tag=$IMAGE_TAG" \
                                        -out=tfplan

                                        PLAN_EXIT=$?
                                        set -e

                                        if [ "$PLAN_EXIT" -eq 1 ]; then
                                            echo "Terraform plan failed!"
                                            exit 1
                                        fi

                                        if [ "$PLAN_EXIT" -eq 2 ]; then
                                            echo "Changes detected. Applying..."

                                            terraform apply \
                                            -input=false \
                                            -lock-timeout=5m \
                                            tfplan

                                        else
                                            echo "No infrastructure changes detected."
                                        fi

                                        echo "========== Verify Deployment =========="
                                        kubectl rollout status \
                                        deployment/streamlit-deploy \
                                        -n streamlit-terraform \
                                        --timeout=180s

                                        echo "========== Terraform Outputs =========="
                                        terraform output

                                        echo "========== Deployment Complete =========="
                                    '''
                                }
                            }
                        }
                    }

                    post {
                        always {
                            dir('terraform/kubernetes') {
                                sh '''
                                    rm -f tfplan
                                    echo "Terraform temporary plan removed."
                                '''
                            }
                        }
                    }
                }


            }
        }    
    }

    post {
        always {
            emailext(
                    attachLog: true,
                    subject: "${currentBuild.currentResult}",
                    body: """
                        Project: ${env.JOB_NAME}<br/>
                        Build: ${env.BUILD_NUMBER}<br/>
                        Image: ${env.FULL_IMAGE ?: 'Not built'}<br/>
                        URL: ${env.BUILD_URL}<br/>
                    """,
                    to: 'shaikh4huda@gmail.com',
                    attachmentsPattern: 'trivyfs.txt,trivyimage.txt'
                    )
                }
    }        
       
        
}