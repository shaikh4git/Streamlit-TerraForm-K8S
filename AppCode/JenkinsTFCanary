
pipeline {
    agent { label 'DevopsAgentLabelV9' }

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        IMAGE_REPO = 'shaikhdocker/sshuda-streamlit-app'
    }

    stages {


        stage('Clean Workspaces!!') {
            steps { cleanWs() }
                }
 
        stage('Checkout GitHub') {
            steps {
                checkout(
                    changelog: true,
                    poll: true,
                    scm: scmGit(
                        branches: [[name: '*/main']],
                        userRemoteConfigs: [[
                            url: 'https://github.com/shaikh4git/Streamlit-TerraForm-K8S.git'
                        ]]
                    )
                )

                script {
                    env.IMAGE_TAG =
                        "${env.BUILD_NUMBER}-${env.GIT_COMMIT.take(7)}"
                    env.FULL_IMAGE =
                        "${env.IMAGE_REPO}:${env.IMAGE_TAG}"

                    echo "Changelog sets: ${currentBuild.changeSets.size()}"
                }
            }
        }

        
        stage ('Run only for relevant changes!!!') {
            when {
                anyOf {
                    changeset "AppCode/app.py"
                    changeset "AppCode/Dockerfile"
                    changeset "AppCode/requirements.txt"
                    changeset "AppCode/JenkinsTFCanary"
                    changeset "AppCode/tests/test_app.py"
                    changeset "AppCode/ansible/staging_canary.yaml"
                    changeset "terraform/main.tf"
                    changeset "terraform/outputs.tf"
                    changeset "terraform/variables.tf"
                    changeset "terraform/terrafom.tfvars"
                }
            }

            stages {
             
                stage('Gitleaks Secret Scanning') {
                    steps {
                        script {
                            sh '''
                                echo "Checking Git repository history..."

                                if [ "$(git rev-parse --is-shallow-repository)" = "true" ]; then
                                    git fetch --unshallow
                                else
                                    echo "Repository already has full history."
                                fi

                                echo "Starting Gitleaks security scan..."

                                gitleaks git . \
                                    --redact \
                                    --report-format json \
                                    --report-path gitleaks-report.json
                            '''
                        }
                    }

                    post {
                        always {
                        archiveArtifacts artifacts: 'gitleaks-report.json', allowEmptyArchive: true
                        }
                    }
                }
              
                stage('Docker Build Streamlit Image') {
                    steps {
                        sh '''
                            echo "Building Docker image: $FULL_IMAGE"

                            docker buildx build \
                                --tag "$FULL_IMAGE" \
                                --load \
                                AppCode/.

                            echo "Docker image built successfully"
                        '''
                    }
                }

                stage('Docker Push to Docker Hub') {
                    steps {
                        withCredentials([
                            string(
                                credentialsId: 'docker_cred',
                                variable: 'DOCKER_API_KEY'
                            )
                        ]) {
                            sh '''
                                set -e
                                set +x

                                echo "$DOCKER_API_KEY" |
                                    docker login -u shaikhdocker --password-stdin

                                echo "Pushing image: $FULL_IMAGE"

                                docker push "$FULL_IMAGE"

                                echo "Docker image pushed successfully"
                            '''
                        }
                    }
                }


                stage('Deploy to Docker Desktop Staging - via Ansible') {
                    steps {
                        sh '''
                            ansible-playbook \
                            -i localhost, \
                            AppCode/ansible/staging_canary.yaml \
                            -e "image_repo=$IMAGE_REPO" \
                            -e "image_tag=$IMAGE_TAG"
                        '''
                    }
                } 


                stage('Generate Kubernetes ServiceAccount Kubeconfig') {
                    steps {
                        timeout(time: 3, unit: 'MINUTES') {
                            withCredentials([
                                file(
                                    credentialsId: 'kubeconfig-bootstrap',
                                    variable: 'BOOTSTRAP_KUBECONFIG'
                                )
                            ]) {
                                sh '''#!/usr/bin/env bash
                set -euo pipefail
                set +x
                umask 077

                echo "===== Verify Bootstrap Authentication ====="
                kubectl --kubeconfig="$BOOTSTRAP_KUBECONFIG" auth whoami

                mkdir -p "$WORKSPACE/.terraform-auth"
                chmod 700 "$WORKSPACE/.terraform-auth"

                echo "===== Generate Fresh SA Token and Kubeconfig ====="

                bash scripts/generate-sa-kubeconfig.sh \
                "$WORKSPACE/.terraform-auth/sa-kubeconfig.yaml"

                echo "ServiceAccount kubeconfig generated."
                '''
                            }
                        }
                    }
                }

                stage('Terraform Init and Validate') {
                    steps {
                        timeout(time: 3, unit: 'MINUTES') {
                            dir('terraform') {
                                sh '''#!/usr/bin/env bash
                set -euo pipefail

                export KUBECONFIG="$WORKSPACE/.terraform-auth/sa-kubeconfig.yaml"
                export KUBE_CONFIG_PATH="$KUBECONFIG"

                echo "===== Verify ServiceAccount Identity ====="
                kubectl auth whoami

                echo "===== Verify Kubernetes Access ====="
                kubectl auth can-i create deployments \
                -n streamlit-terraform | grep -qx yes

                echo "===== Terraform Init ====="
                terraform init -input=false

                echo "===== Terraform Validate ====="
                terraform validate
                '''
                            }
                        }
                    }
                }

                stage('Terraform Plan Streamlit') {
                    steps {
                        timeout(time: 5, unit: 'MINUTES') {
                            dir('terraform') {
                                sh '''#!/usr/bin/env bash
                set -euo pipefail
                umask 077

                export KUBECONFIG="$WORKSPACE/.terraform-auth/sa-kubeconfig.yaml"
                export KUBE_CONFIG_PATH="$KUBECONFIG"

                echo "===== Terraform Plan ====="

                terraform plan \
                -input=false \
                -var="namespace=streamlit-terraform" \
                -var="create_namespace=false" \
                -var="image_tag=$IMAGE_TAG" \
                -out="$WORKSPACE/.terraform-auth/tfplan"

                echo "Terraform plan generated."
                '''
                            }
                        }
                    }
                }

                stage('Terraform Apply Streamlit') {
                    steps {
                        timeout(time: 5, unit: 'MINUTES') {
                            dir('terraform') {
                                sh '''#!/usr/bin/env bash
                                set -euo pipefail

                                export KUBECONFIG="$WORKSPACE/.terraform-auth/sa-kubeconfig.yaml"
                                export KUBE_CONFIG_PATH="$KUBECONFIG"

                                echo "===== Terraform Apply ====="

                                terraform apply \
                                -input=false \
                                -auto-approve \
                                "$WORKSPACE/.terraform-auth/tfplan"

                                echo "===== Verify Kubernetes Deployment ====="

                                kubectl rollout status \
                                deployment/streamlit-deploy \
                                -n streamlit-terraform \
                                --timeout=120s

                                echo "===== Running Resources ====="

                                kubectl get deployments,services,pods \
                                -n streamlit-terraform

                                echo "Streamlit Kubernetes deployment successful."
                                '''
                            }
                        }
                    }
                }
            }
        }    
    }
              
}