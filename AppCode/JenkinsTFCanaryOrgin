                    }
                }              */  

              
                stage('Docker Build Streamlit Image') {
                    steps {
                        sh '''
                            echo "Building Docker image: $FULL_IMAGE"

                            docker buildx build \
                                --tag "$FULL_IMAGE" \
                                --load \
                                AppCode/.

                            echo "Docker image built successfully"
                        '''
                    }
                }

                stage('Docker Push to Docker Hub') {
                    steps {
                        withCredentials([
                            string(
                                credentialsId: 'docker_cred',
                                variable: 'DOCKER_API_KEY'
                            )
                        ]) {
                            sh '''
                                set -e
                                set +x

                                echo "$DOCKER_API_KEY" |
                                    docker login -u shaikhdocker --password-stdin

                                echo "Pushing image: $FULL_IMAGE"

                                docker push "$FULL_IMAGE"

                                echo "Docker image pushed successfully"
                            '''
                        }
                    }
                }


                stage('Deploy to Docker Desktop Staging - via Ansible') {
                    steps {
                        sh '''
                            ansible-playbook \
                            -i localhost, \
                            AppCode/ansible/staging_canary.yaml \
                            -e "image_repo=$IMAGE_REPO" \
                            -e "image_tag=$IMAGE_TAG"
                        '''
                    }
                } 

                stage('Terraform Init and Verify Bootstrap') {
                    steps {
                        timeout(time: 3, unit: 'MINUTES') {
                            withCredentials([
                                file(
                                    credentialsId: 'kubeconfig-bootstrap',
                                    variable: 'BOOTSTRAP_KUBECONFIG'
                                )
                            ]) {
                                dir('terraform') {
                                    sh '''#!/usr/bin/env bash
                set -euo pipefail

                export KUBECONFIG="$BOOTSTRAP_KUBECONFIG"
                export KUBE_CONFIG_PATH="$BOOTSTRAP_KUBECONFIG"

                kubectl auth whoami

                terraform init -input=false
                terraform validate
                '''
                                }
                            }
                        }
                    }
                }

                stage('Terraform Plan') {
                    steps {
                        timeout(time: 5, unit: 'MINUTES') {
                            withCredentials([
                                file(
                                    credentialsId: 'kubeconfig-bootstrap',
                                    variable: 'BOOTSTRAP_KUBECONFIG'
                                )
                            ]) {
                                dir('terraform') {
                                    sh '''#!/usr/bin/env bash
                set -euo pipefail
                umask 077

                export KUBECONFIG="$BOOTSTRAP_KUBECONFIG"
                export KUBE_CONFIG_PATH="$BOOTSTRAP_KUBECONFIG"

                terraform plan \
                -input=false \
                -var="namespace=terraform-system" \
                -var="create_namespace=true" \
                -var="image_tag=$IMAGE_TAG" \
                -out=tfplan
                '''
                                }
                            }
                        }
                    }
                }

                stage('Terraform Apply') {
                    steps {
                        timeout(time: 5, unit: 'MINUTES') {
                            withCredentials([
                                file(
                                    credentialsId: 'kubeconfig-bootstrap',
                                    variable: 'BOOTSTRAP_KUBECONFIG'
                                )
                            ]) {
                                dir('terraform') {
                                    sh '''#!/usr/bin/env bash
                set -euo pipefail

                export KUBECONFIG="$BOOTSTRAP_KUBECONFIG"
                export KUBE_CONFIG_PATH="$BOOTSTRAP_KUBECONFIG"

                terraform apply \
                -input=false \
                -auto-approve \
                tfplan

                kubectl get serviceaccount,role,rolebinding \
                -n terraform-system
                '''
                                }
                            }
                        }
                    }
                }

                stage('Generate and Verify ServiceAccount Kubeconfig') {
                    steps {
                        timeout(time: 3, unit: 'MINUTES') {
                            withCredentials([
                                file(
                                    credentialsId: 'kubeconfig-bootstrap',
                                    variable: 'BOOTSTRAP_KUBECONFIG'
                                )
                            ]) {
                                sh '''#!/usr/bin/env bash
                set -euo pipefail
                set +x
                umask 077

                export K8S_API_SERVER="https://host.docker.internal:6443"

                mkdir -p "$WORKSPACE/.terraform-auth"

                bash scripts/generate-sa-kubeconfig.sh \
                terraform-system \
                "$WORKSPACE/.terraform-auth"

                export KUBECONFIG="$WORKSPACE/.terraform-auth/sa-kubeconfig.yaml"

                kubectl auth whoami

                kubectl auth can-i create deployments \
                -n terraform-system | grep -qx yes

                kubectl get deployments,services \
                -n terraform-system
                '''
                            }
                        }
                    }
                }


                    post {
                        always {
                            dir('terraform/kubernetes') {
                                sh '''
                                    rm -f tfplan
                                    echo "Terraform temporary plan removed."
                                '''
                            }
                        }
                    }
                }
            }
        }    
    
              
