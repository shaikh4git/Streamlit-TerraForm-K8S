
pipeline {
    agent { label 'DevopsAgentLabelV9' }

    options {
        disableConcurrentBuilds()
        timestamps()
        skipDefaultCheckout(true)
    }

    environment {
        IMAGE_REPO = 'shaikhdocker/sshuda-streamlit-app'
    }

    stages {
        stage('Clean Workspaces!!!') {
            steps { cleanWs() }
        }

        stage('Checkout GitHub!') {
            steps {
                script {
                    def gitInfo = checkout scm

                    env.GIT_COMMIT = gitInfo.GIT_COMMIT
                    env.GIT_BRANCH = gitInfo.GIT_BRANCH ?: ''

                    env.IMAGE_TAG =
                        "${env.BUILD_NUMBER}-${env.GIT_COMMIT.take(7)}"

                    env.FULL_IMAGE =
                        "${env.IMAGE_REPO}:${env.IMAGE_TAG}"

                    echo "Git Branch: ${env.GIT_BRANCH}"
                    echo "Git Commit: ${env.GIT_COMMIT}"
                    echo "Docker Image: ${env.FULL_IMAGE}"
                    echo "Changelog sets: ${currentBuild.changeSets.size()}"
                }
            }
        }

        stage('Gitleaks Secret Scanning!!') {
            steps {
                script {
                    sh '''
                        echo "Checking Git repository history..."

                        if [ "$(git rev-parse --is-shallow-repository)" = "true" ]; then
                            git fetch --unshallow
                        else
                            echo "Repository already has full history!!."
                        fi

                        echo "Starting Gitleaks security scan..."

                        gitleaks git . \
                            --redact \
                            --report-format json \
                            --report-path gitleaks-report.json
                    '''
                }
            }

            post {
                always {
                    archiveArtifacts artifacts: 'gitleaks-report.json', allowEmptyArchive: true
                }
            }
        }

        stage('Docker Build Streamlit Image') {
            steps {
                sh '''
                    echo "Building Docker image: $FULL_IMAGE"

                    docker buildx build \
                        --tag "$FULL_IMAGE" \
                        --load \
                        AppCode/.

                    echo "Docker image built successfully!!!"
                '''
            }
        }

        stage('Deploy to Docker Desktop Staging - via Ansible') {
            steps {
                sh '''
                    ansible-playbook \
                        -i localhost, \
                        AppCode/ansible/staging_canary.yaml \
                        -e "image_repo=$IMAGE_REPO" \
                        -e "image_tag=$IMAGE_TAG"
                '''
            }
        }

        stage('Generate Kubernetes ServiceAccount Kubeconfig!') {
            steps {
                timeout(time: 3, unit: 'MINUTES') {
                    withCredentials([
                        file(
                            credentialsId: 'kubeconfig-bootstrap',
                            variable: 'BOOTSTRAP_KUBECONFIG'
                        )
                    ]) {
                        sh '''#!/usr/bin/env bash
                            set -euo pipefail
                            set +x
                            umask 077

                            echo "===== Verify Bootstrap Authentication ======"
                            kubectl --kubeconfig="$BOOTSTRAP_KUBECONFIG" auth whoami

                            mkdir -p "$WORKSPACE/.terraform-auth"
                            chmod 700 "$WORKSPACE/.terraform-auth"

                            echo "===== Generate Fresh SA Token and Kubeconfig ====="

                            bash scripts/generate-sa-kubeconfig.sh \
                                "$WORKSPACE/.terraform-auth/sa-kubeconfig.yaml"

                            echo "ServiceAccount kubeconfig generated!!."
                        '''
                    }
                }
            }
        }

        stage('Terraform Init and Validate') {
            steps {
                timeout(time: 3, unit: 'MINUTES') {
                    dir('terraform') {
                        sh '''#!/usr/bin/env bash
                            set -euo pipefail

                            export KUBECONFIG="$WORKSPACE/.terraform-auth/sa-kubeconfig.yaml"
                            export KUBE_CONFIG_PATH="$KUBECONFIG"

                            echo "===== Verify ServiceAccount Identity ====="
                            kubectl auth whoami

                            echo "===== Verify Kubernetes Access ====="
                            kubectl auth can-i create deployments \
                                -n streamlit-terraform | grep -qx yes

                            echo "===== Terraform Init ====="
                            terraform init -input=false

                            echo "===== Terraform Validate ====="
                            terraform validate
                        '''
                    }
                }
            }
        }

        stage('Import Existing Kubernetes Resources') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    dir('terraform') {
                        sh '''#!/usr/bin/env bash
set -euo pipefail

export KUBECONFIG="$WORKSPACE/.terraform-auth/sa-kubeconfig.yaml"
export KUBE_CONFIG_PATH="$KUBECONFIG"

echo "===== Verify Kubernetes Identity ====="
kubectl auth whoami

echo "===== Check Terraform State ====="

STATE_LIST="$(terraform state list 2>/dev/null || true)"

echo "===== Check Existing Deployment ====="

if echo "$STATE_LIST" | grep -Fxq 'kubernetes_deployment_v1.streamlit'; then
    echo "Deployment already managed by Terraform."

elif kubectl get deployment streamlit-deploy \
     -n streamlit-terraform >/dev/null 2>&1; then

    echo "Deployment exists. Importing..."

    terraform import \
      -input=false \
      -var="namespace=streamlit-terraform" \
      -var="create_namespace=false" \
      -var="image_tag=$IMAGE_TAG" \
      kubernetes_deployment_v1.streamlit \
      streamlit-terraform/streamlit-deploy

else
    echo "Deployment not found. Terraform will create it."
fi

STATE_LIST="$(terraform state list 2>/dev/null || true)"

echo "===== Check Existing Service ====="

if echo "$STATE_LIST" | grep -Fxq 'kubernetes_service_v1.streamlit'; then
    echo "Service already managed by Terraform."

elif kubectl get service streamlit-service \
     -n streamlit-terraform >/dev/null 2>&1; then

    echo "Service exists. Importing..."

    terraform import \
      -input=false \
      -var="namespace=streamlit-terraform" \
      -var="create_namespace=false" \
      -var="image_tag=$IMAGE_TAG" \
      kubernetes_service_v1.streamlit \
      streamlit-terraform/streamlit-service

else
    echo "Service not found. Terraform will create it."
fi

echo "===== Final Terraform State ====="

terraform state list || true
'''
                    }
                }
            }
        }

        stage('Terraform Plan Streamlit') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    dir('terraform') {
                        sh '''#!/usr/bin/env bash
                            set -euo pipefail
                            umask 077

                            export KUBECONFIG="$WORKSPACE/.terraform-auth/sa-kubeconfig.yaml"
                            export KUBE_CONFIG_PATH="$KUBECONFIG"

                            echo "===== Terraform Plan ====="

                            terraform plan \
                                -input=false \
                                -var="namespace=streamlit-terraform" \
                                -var="create_namespace=false" \
                                -var="image_tag=$IMAGE_TAG" \
                                -out="$WORKSPACE/.terraform-auth/tfplan"

                            echo "Terraform plan generated."
                        '''
                    }
                }
            }
        }

        stage('Terraform Apply Streamlit') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    dir('terraform') {
                        sh '''#!/usr/bin/env bash
                            set -euo pipefail

                            export KUBECONFIG="$WORKSPACE/.terraform-auth/sa-kubeconfig.yaml"
                            export KUBE_CONFIG_PATH="$KUBECONFIG"

                            echo "===== Terraform Apply ====="

                            terraform apply \
                                -input=false \
                                -auto-approve \
                                "$WORKSPACE/.terraform-auth/tfplan"

                            echo "===== Verify Kubernetes Deployment ====="

                            kubectl rollout status \
                                deployment/streamlit-deploy \
                                -n streamlit-terraform \
                                --timeout=120s

                            echo "===== Running Resources ====="

                            kubectl get deployments,services,pods \
                                -n streamlit-terraform

                            echo "Streamlit Kubernetes deployment successful."
                        '''
                    }
                }
            }
        }

        stage('Terraform Outputs & Deployment Verification') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    dir('terraform') {
                        sh '''#!/usr/bin/env bash
                            set -euo pipefail

                            export KUBECONFIG="$WORKSPACE/.terraform-auth/sa-kubeconfig.yaml"
                            export KUBE_CONFIG_PATH="$KUBECONFIG"

                            echo "========================================"
                            echo "       TERRAFORM OUTPUT VALUES"
                            echo "========================================"

                            terraform output

                            echo ""
                            echo "===== Retrieve Individual Outputs ====="

                            NAMESPACE="$(terraform output -raw namespace)"
                            DEPLOYMENT="$(terraform output -raw deployment_name)"
                            SERVICE="$(terraform output -raw service_name)"
                            IMAGE="$(terraform output -raw deployed_image)"
                            MANAGED="$(terraform output -raw namespace_managed_by_terraform)"

                            echo "Namespace          : $NAMESPACE"
                            echo "Terraform Managed  : $MANAGED"
                            echo "Deployment         : $DEPLOYMENT"
                            echo "Service            : $SERVICE"
                            echo "Docker Image       : $IMAGE"

                            echo ""
                            echo "===== Verify Kubernetes Deployment ====="

                            kubectl rollout status \
                            deployment/"$DEPLOYMENT" \
                            -n "$NAMESPACE" \
                            --timeout=120s

                            echo ""
                            echo "===== Verify Actual Running Image ====="

                            kubectl get deployment "$DEPLOYMENT" \
                            -n "$NAMESPACE" \
                            -o jsonpath='{.spec.template.spec.containers[0].image}'

                            echo ""
                            echo ""
                            echo "===== Verify Kubernetes Service ====="

                            kubectl get service "$SERVICE" \
                            -n "$NAMESPACE"

                            echo ""
                            echo "===== List Application Pods ====="

                            kubectl get pods \
                            -n "$NAMESPACE" \
                            -l app=streamlit \
                            -o wide

                            echo ""
                            echo "========================================"
                            echo "    STREAMLIT DEPLOYMENT SUCCESSFUL"
                            echo "========================================"

                        '''
                    }
                }
            }
        }

        stage('Approval for Terraform Destroy!!') {
            steps {
                script {
                        input(
                    message: 'Are you sure you want to DESTROY the Streamlit Kubernetes Deployment and Service in namespace streamlit-terraform?',
                    ok: 'Approve Terraform Destroy',
                    submitterParameter: 'APPROVED_BY'
                            )
                }
            }
        }

        stage('Terraform Destroy Streamlit') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    dir('terraform') {
                        sh '''#!/usr/bin/env bash
                        set -euo pipefail

                        export KUBECONFIG="$WORKSPACE/.terraform-auth/sa-kubeconfig.yaml"
                        export KUBE_CONFIG_PATH="$KUBECONFIG"

                        echo "===== Verify Kubernetes Identity ====="
                        kubectl auth whoami

                        echo "===== Terraform Destroy ====="

                        terraform destroy \
                        -input=false \
                        -auto-approve \
                        -var="namespace=streamlit-terraform" \
                        -var="create_namespace=false" \
                        -var="image_tag=$IMAGE_TAG"

                        echo "===== Verify Resources Removed ====="

                        if kubectl get deployment streamlit-deploy \
                        -n streamlit-terraform >/dev/null 2>&1; then
                            echo "ERROR: Deployment still exists."
                            exit 1
                        fi

                        if kubectl get service streamlit-service \
                        -n streamlit-terraform >/dev/null 2>&1; then
                            echo "ERROR: Service still exists."
                            exit 1
                        fi

                        echo "Terraform Destroy completed successfully."
                        '''
                    }
                }
            }
        }
    }
}
